# Copier vers .env
PORT=2567
WEB_ORIGIN=http://localhost:3000
# Obligatoire en production (une valeur de développement est utilisée sinon).
GUEST_TOKEN_SECRET=
# Optionnel : sans Supabase, seuls les invités peuvent se connecter.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret serveur : nécessaire pour enregistrer les résultats de parties. Ne jamais le mettre côté web.
SUPABASE_SERVICE_ROLE_KEY=
